# Production defaults for `next build` — public values only (they are baked
# into the browser bundle anyway). Secrets (JWT_SECRET, JWT_REFRESH_SECRET,
# SMTP_*, MSG91_*, BLOB_*) go in the Vercel project's Environment Variables,
# never here. A value set in Vercel overrides the same name in this file.

# The live admin panel (arshanemi-admin-pannels) — login, coins and saved
# links all go through it. Use www: the bare domain answers with a redirect.
NEXT_PUBLIC_ADMIN_API_URL=https://www.barmeto.com
NEXT_PUBLIC_IS_CONNECT=true
NEXT_PUBLIC_IS_PAID=true
NEXT_PUBLIC_IS_OTP_Verifications_Disable=false
NEXT_PUBLIC_IS_Header_Hide=false
NEXT_PUBLIC_SHOW_FLOATING_MENU=false

# This app's own public address — where the desktop app (desktop/package.json
# linkOpener.appUrl) and the catalog's toolUrl point.
NEXT_PUBLIC_SITE_URL=https://link-opener.barmeto.com

TOOLS_NAME=barmeto-link-opener
ALLOWED_ORIGINS="https://www.barmeto.com,https://barmeto.com"
