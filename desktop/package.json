{
  "name": "barmeto-link-opener-desktop",
  "productName": "Barmeto Link Opener",
  "version": "1.1.0",
  "description": "Windows desktop app for the Chrome Link Opener tool — opens links in their Chrome profile and launches saved desktop applications.",
  "author": "Barmeto",
  "private": true,
  "main": "src/main.js",
  "type": "commonjs",
  "linkOpener": {
    "appUrl": "https://link-opener.barmeto.com"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.barmeto.linkopener",
    "productName": "Barmeto Link Opener",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Barmeto Link Opener"
    }
  }
}
